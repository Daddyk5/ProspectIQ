# Leave empty to use the Vite dev proxy (/api and /ws → http://127.0.0.1:8080).
VITE_API_BASE_URL=
# Optional explicit WebSocket URL; derived from VITE_API_BASE_URL (or the page origin) when empty.
VITE_WS_URL=
# Google Maps JavaScript API key (Maps JavaScript API enabled, HTTP-referrer restricted).
VITE_GOOGLE_MAPS_API_KEY=
# Optional. When set, uses Advanced Markers + cloud map styling instead of the bundled dark JSON style.
VITE_GOOGLE_MAPS_MAP_ID=
# Onboarding video shown in the Welcome modal.
VITE_WELCOME_VIDEO_URL=/media/prospectiq-welcome.mp4
