PORT=8080
HOST=127.0.0.1
# Comma-separated browser origins allowed for REST + WebSocket
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Emits demo live events (signals, conversions, intent drift). Set false when a real pipeline feeds the store.
SIMULATE_LIVE=true

# Local Ollama instance
OLLAMA_HOST=http://localhost:11434
# Tried in order; the next model is used if one is not installed
OLLAMA_MODELS=llama3.2:3b,llama3,mistral
OLLAMA_MAX_TOKENS=600
OLLAMA_CONNECT_TIMEOUT_MS=5000
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=60000
OLLAMA_IDLE_TIMEOUT_MS=20000
OLLAMA_TOTAL_TIMEOUT_MS=120000
AI_RATE_LIMIT_PER_MIN=12
